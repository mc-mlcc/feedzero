# FeedZero server settings (copy to .env beside docker-compose.yml).
#
#   cp .env.example .env
#
# Every value has a working default for the tnnlabs server; the file exists
# to pin a version and to move paths without editing compose.

# Image tag to run. `latest` follows the most recent deploy; pin a release
# (e.g. v0.18.1) when you want the server to stop moving.
FEEDZERO_VERSION=latest

# Host port published for Nginx Proxy Manager. Container port stays 3000.
HOST_PORT=3000

# Host directory holding the encrypted vaults.
DATA_DIR=/mnt/Olympus/Docker/feedzero/data

# Container timezone, used for log timestamps.
TZ=Asia/Hong_Kong
