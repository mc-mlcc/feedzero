# Publish settings for scripts/deploy-image.ps1 — copy to .env.deploy.
#
#   Copy-Item .env.deploy.example .env.deploy
#
# `.env.deploy` is gitignored (via `.env.*`) and never enters the Docker build
# context: secrets cannot reach an image layer.
#
# The image path carries no tag: the script appends vX.Y.Z, X.Y, latest and
# sha-<commit>. It must name the registry explicitly so a misconfiguration
# cannot push the image to Docker Hub by accident.

IMAGE=hub.tnnlabs.space/feedzero

# Credentials — leave both commented out for a registry that accepts
# unauthenticated pushes (the tnnlabs registry does). Set BOTH to log in
# first; setting only one is rejected, because that is always a typo.
#
# REGISTRY_USERNAME=deploy
# REGISTRY_PASSWORD=registry-password-or-token
